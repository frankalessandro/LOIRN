---
import { money } from "../lib/shop";
import type { Product, ProductVariant } from "../lib/shop";

interface Props {
  product: Product;
  eager?: boolean;
  /** true = morph hacia la ficha (index/catálogo); false = tarjeta "relacionados" sin morph */
  share?: boolean;
}
const { product, eager = false, share = true } = Astro.props;
const href = `/producto/${product.slug}`;
// El morph hacia la ficha usa un nombre compartido (`product-shot` /
// `product-title`) que un script coloca sobre la card en la que se hace
// click. `share={false}` (relacionados) = sin morph, solo fundido.

// Compra rápida: cada talla del desplegable lleva serializada su propia
// línea de carrito, con el variantId que el checkout de Shopify espera.
const line = (v: ProductVariant) =>
  JSON.stringify({
    variantId: v.id,
    productSlug: product.slug,
    name: product.name,
    size: v.size,
    price: v.price,
    compareAt: v.compareAtPrice,
    image: product.images[0],
  });

const oneSize = product.variants.length === 1;
const soldOut = !product.availableForSale;
const only = product.variants[0];
const pickerId = `sizes-${product.slug}`;
const subtitle = [product.collection, product.colorway].filter(Boolean).join(" · ");
---

<article class="pcard" data-pcard data-slug={product.slug} data-morph={share ? "1" : "0"} data-images={JSON.stringify(product.images)}>
  <div class="pcard__stage">
    <div class="pcard__tools">
      <button class="pcard__icon" type="button" aria-pressed="false" data-wish aria-label="Guardar en favoritos">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 21s-7.5-4.6-10-9A5.3 5.3 0 0 1 12 6a5.3 5.3 0 0 1 10 6c-2.5 4.4-10 9-10 9Z"></path>
        </svg>
      </button>
    </div>

    <div class="pcard__spin" role="group" aria-label="Cambiar vista">
      <button type="button" data-prev aria-label="Vista anterior">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m15 6-6 6 6 6"></path></svg>
      </button>
      <span class="pcard__spin-div"></span>
      <button type="button" data-next aria-label="Vista siguiente">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 6 6 6-6 6"></path></svg>
      </button>
    </div>

    <a href={href} class="pcard__frame" aria-label={`Ver ${product.name}`}>
      <img
        class="pcard__img"
        src={product.images[0]}
        alt={product.name}
        width="1100"
        height="1400"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </a>

    <div class="pcard__scrim" aria-hidden="true"></div>

    <div class="pcard__overlay">
      <div class="pcard__headline">
        <a href={href}>
          <h3 class="pcard__title">{product.name}</h3>
        </a>
        {product.discountLabel && (
          <span class="badge-disc pcard__disc">{product.discountLabel}</span>
        )}
      </div>

      {subtitle && <p class="pcard__sub">{subtitle}</p>}

      <div class="pcard__row">
        <span class="pcard__prices">
          {product.compareAt && (
            <s class="pcard__was u-price">{money(product.compareAt)}</s>
          )}
          <span class="u-price pcard__now">{money(product.price)}</span>
        </span>

        {oneSize && only ? (
          <button
            type="button"
            class="pcard__cta"
            data-add-to-cart
            data-line={line(only)}
            disabled={soldOut}
          >
            {soldOut ? "Agotado" : `Talla ${only.size}`}
          </button>
        ) : (
          <div class="pcard__picker" data-picker>
            <button
              type="button"
              class="pcard__cta"
              data-picker-toggle
              aria-expanded="false"
              aria-controls={pickerId}
              disabled={soldOut}
            >
              <span data-picker-label>{soldOut ? "Agotado" : "Elegir talla"}</span>
              {!soldOut && (
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m6 9 6 6 6-6"></path></svg>
              )}
            </button>

            <div class="pcard__sizes" id={pickerId} data-picker-menu hidden>
              <p class="pcard__sizes-head u-code">Talla</p>
              <div class="pcard__sizes-grid">
                {product.variants.map((v) => (
                  <button
                    type="button"
                    class="pcard__sizebtn"
                    data-add-to-cart
                    data-line={line(v)}
                    disabled={!v.availableForSale}
                    aria-label={v.availableForSale
                      ? `Agregar talla ${v.size} al carrito`
                      : `Talla ${v.size} agotada`}
                  >
                    {v.size}
                  </button>
                ))}
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .pcard {
    position: relative;
    border-radius: var(--r-lg);
    box-shadow: var(--sh-glass);
    transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease-out);
  }
  .pcard:hover {
    transform: translateY(-4px);
    box-shadow: 0 52px 90px -28px rgba(12, 12, 13, 0.34);
  }

  /* ---- Escenario: foto a sangre, borde a borde ---- */
  .pcard__stage {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    background: linear-gradient(155deg, var(--loirn-paper-2) 0%, var(--loirn-paper-3) 100%);
    isolation: isolate;
  }

  .pcard__frame { position: absolute; inset: 0; display: block; z-index: 1; }
  .pcard__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-lg);
    transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-3) var(--ease-out);
  }
  .pcard[data-busy] .pcard__img { opacity: 0; transform: scale(0.98); }

  /* Scrim: oscurece la base de la foto para que el texto flote legible encima */
  .pcard__scrim {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    border-radius: var(--r-lg);
    background: linear-gradient(
      180deg,
      rgba(12, 12, 13, 0) 40%,
      rgba(12, 12, 13, 0.35) 68%,
      rgba(12, 12, 13, 0.88) 100%
    );
  }

  /* ---- Herramientas flotantes ---- */
  .pcard__tools { position: absolute; top: var(--sp-3); left: var(--sp-3); z-index: 4; }
  .pcard__icon {
    display: inline-grid; place-items: center;
    width: 38px; height: 38px;
    border-radius: var(--r-pill);
    color: var(--loirn-paper);
    background: rgba(12, 12, 13, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(8px);
    transition: background var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out);
  }
  .pcard__icon:hover { background: rgba(12, 12, 13, 0.5); transform: translateY(-1px); }
  .pcard__icon.is-on { background: var(--loirn-paper); color: var(--loirn-ink); }

  /* pill de rotación ‹ › — arriba, centrada */
  .pcard__spin {
    position: absolute;
    top: var(--sp-3); left: 50%;
    translate: -50% 0;
    z-index: 4;
    display: flex; align-items: center;
    background: rgba(12, 12, 13, 0.28);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--r-pill);
    backdrop-filter: blur(8px);
  }
  .pcard__spin button {
    display: grid; place-items: center;
    width: 32px; height: 30px;
    color: var(--loirn-paper);
    transition: background var(--dur-1) var(--ease-out);
    border-radius: var(--r-pill);
  }
  .pcard__spin button:hover { background: rgba(255, 255, 255, 0.16); }
  .pcard__spin-div { width: 1px; height: 14px; background: rgba(255, 255, 255, 0.24); }

  /* ---- Info sobre el scrim ---- */
  .pcard__overlay {
    position: absolute; inset: auto 0 0 0; z-index: 3;
    padding: clamp(1rem, 3vw, 1.5rem);
    display: grid; gap: .4em;
    color: var(--loirn-paper);
  }
  .pcard__headline { display: flex; align-items: baseline; gap: var(--sp-2); flex-wrap: wrap; }
  .pcard__title {
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.1rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 0.95;
    color: var(--loirn-paper);
  }
  .pcard__disc { flex-shrink: 0; padding: .3em .7em; font-size: var(--fs-100); }
  .pcard__sub {
    font-family: var(--font-label); text-transform: uppercase;
    letter-spacing: .08em; font-size: var(--fs-100);
    color: rgba(235, 236, 236, 0.66);
  }

  .pcard__row { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); margin-top: .3em; }
  .pcard__prices { display: inline-flex; align-items: baseline; gap: var(--sp-2); white-space: nowrap; }
  .pcard__was { color: rgba(235, 236, 236, 0.55); font-size: var(--fs-200); text-decoration-thickness: 1px; }
  .pcard__now { font-size: clamp(1.2rem, 1rem + .8vw, 1.5rem); }

  /* ---- CTA: pill de vidrio oscuro, mismo trato que "Follow" ---- */
  .pcard__cta {
    display: inline-flex; align-items: center; gap: .4em;
    padding: .7em 1.1em;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(10px);
    color: var(--loirn-paper);
    font-family: var(--font-label);
    font-weight: 400;
    font-size: var(--fs-200);
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background var(--dur-1) var(--ease-out), transform var(--dur-1) var(--ease-out);
  }
  .pcard__cta:hover:not(:disabled) { background: rgba(255, 255, 255, 0.24); transform: translateY(-1px); }
  .pcard__cta:disabled { opacity: .5; cursor: not-allowed; }
  .pcard__cta.is-added { background: var(--loirn-paper); color: var(--loirn-ink); }

  /* ---- Desplegable de tallas (compra rápida) ---- */
  .pcard__picker { position: relative; }
  /* la card con el desplegable abierto se pone por encima de sus vecinas */
  .pcard:has([data-picker-menu]:not([hidden])) { position: relative; z-index: 40; }

  .pcard__sizes {
    position: absolute;
    bottom: calc(100% + 8px);
    right: 0;
    min-width: 210px;
    z-index: 30;
    padding: var(--sp-3);
    display: grid;
    gap: var(--sp-2);
    background: rgba(255, 255, 255, .96);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-md);
    box-shadow: var(--sh-lg);
    backdrop-filter: blur(14px);
  }
  .pcard__sizes[hidden] { display: none; }
  .pcard__sizes-head { color: var(--text-mute); }
  .pcard__sizes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(46px, 1fr));
    gap: var(--sp-2);
  }
  .pcard__sizebtn {
    padding: .55em .2em;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: .06em;
    font-size: var(--fs-200);
    color: var(--loirn-ink);
    transition: background var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .pcard__sizebtn:hover:not(:disabled) { background: var(--loirn-ink); color: var(--loirn-paper); }
  /* agotada: se muestra tachada, no se esconde — informa disponibilidad */
  .pcard__sizebtn:disabled {
    color: var(--text-mute);
    cursor: not-allowed;
    text-decoration: line-through;
    opacity: .6;
  }
</style>

<script>
  // Rotación de vistas + favoritos. Se re-cablea tras cada navegación del ClientRouter.
  function wireCards() {
    document.querySelectorAll<HTMLElement>("[data-pcard]").forEach((card) => {
      if (card.dataset.wired) return;
      card.dataset.wired = "1";

      let imgs: string[] = [];
      try { imgs = JSON.parse(card.dataset.images || "[]"); } catch {}
      const img = card.querySelector<HTMLImageElement>(".pcard__img");

      if (img && imgs.length > 1) {
        let i = 0;
        imgs.forEach((src) => { const p = new Image(); p.src = src; });
        const go = (dir: number) => {
          i = (i + dir + imgs.length) % imgs.length;
          card.setAttribute("data-busy", "");
          const next = new Image();
          next.src = imgs[i];
          const swap = () => {
            img.src = imgs[i];
            requestAnimationFrame(() => card.removeAttribute("data-busy"));
          };
          next.complete
            ? setTimeout(swap, 160)
            : next.addEventListener("load", () => setTimeout(swap, 60));
        };
        card.querySelector("[data-prev]")?.addEventListener("click", () => go(-1));
        card.querySelector("[data-next]")?.addEventListener("click", () => go(1));
      }

      // ---- desplegable de tallas ----
      const menu = card.querySelector<HTMLElement>("[data-picker-menu]");
      const toggle = card.querySelector<HTMLButtonElement>("[data-picker-toggle]");
      if (menu) {
        const setOpen = (on: boolean) => {
          menu.hidden = !on;
          card
            .querySelectorAll<HTMLElement>("[data-picker-toggle]")
            .forEach((b) => b.setAttribute("aria-expanded", String(on)));
          if (on) menu.querySelector<HTMLButtonElement>(".pcard__sizebtn:not(:disabled)")?.focus();
        };
        card.querySelectorAll<HTMLButtonElement>("[data-picker-toggle]").forEach((b) => {
          b.addEventListener("click", (e) => {
            e.preventDefault();
            const willOpen = menu.hidden;
            closeAllPickers();
            if (willOpen) setOpen(true);
          });
        });
        // añadir una talla cierra el desplegable (el carrito se abre solo)
        menu.addEventListener("click", (e) => {
          if ((e.target as Element).closest("[data-add-to-cart]")) setOpen(false);
        });
        menu.addEventListener("keydown", (e) => {
          if (e.key === "Escape") { setOpen(false); toggle?.focus(); }
        });
      }

      const wish = card.querySelector<HTMLButtonElement>("[data-wish]");
      const slug = card.dataset.slug ?? "";

      if (wish && slug) {
        import("../lib/wishlist/store").then(({ isWishlisted, toggleWish, subscribe }) => {
          const update = () => {
            const on = isWishlisted(slug);
            wish.setAttribute("aria-pressed", String(on));
            wish.classList.toggle("is-on", on);
          };
          update();
          subscribe(update);
          wish.addEventListener("click", () => toggleWish(slug));
        });
      }
    });
  }

  /** Solo un desplegable de tallas abierto a la vez en toda la página. */
  function closeAllPickers() {
    document.querySelectorAll<HTMLElement>("[data-picker-menu]").forEach((m) => {
      m.hidden = true;
    });
    document
      .querySelectorAll<HTMLElement>("[data-picker-toggle]")
      .forEach((b) => b.setAttribute("aria-expanded", "false"));
  }

  // Limpia el nombre de morph de una transición anterior (root: puede ser el
  // documento vivo o el documento entrante que aún no se ha insertado).
  function clearMorphNames(root: Document | Element = document) {
    root.querySelectorAll<HTMLElement>('[data-vt-morph]').forEach((el) => {
      el.style.removeProperty("view-transition-name");
      el.removeAttribute("data-vt-morph");
    });
  }
  function setMorph(el: Element | null | undefined, name: string) {
    if (!(el instanceof HTMLElement)) return;
    el.style.setProperty("view-transition-name", name);
    el.setAttribute("data-vt-morph", "");
  }

  // Antes de navegar a una ficha, marca la card clickeada con el nombre
  // compartido para que su foto y su título hagan "magic move". Fase de
  // captura → corre antes que el router. Las demás cards quedan fuera del
  // morph y se van con el fundido de la página.
  function armMorph(target: EventTarget | null) {
    const link = (target as Element | null)?.closest?.('a[href^="/producto/"]');
    if (!link) return;
    const card = link.closest<HTMLElement>('[data-pcard]');
    if (!card || card.dataset.morph !== "1") return;
    clearMorphNames();
    setMorph(card.querySelector(".pcard__img"), "product-shot");
    setMorph(card.querySelector(".pcard__title"), "product-title");
    (window as any).__loirnFromList = true; // llegamos a la ficha desde un listado
  }

  // Al VOLVER de una ficha a un listado: antes del swap, marca en el
  // documento entrante la card de esa prenda con el mismo nombre, para que
  // la foto de la ficha se "recoja" dentro de su card (morph inverso).
  function armBackMorph(e: any) {
    const from = e?.from?.pathname?.match(/^\/producto\/([^/]+)\/?$/);
    if (!from) return;
    if (/^\/producto\//.test(e?.to?.pathname || "")) return; // producto→producto no
    const doc: Document | undefined = e.newDocument;
    if (!doc) return;
    clearMorphNames(document);
    clearMorphNames(doc);
    const card = doc
      .querySelector(`[data-pcard] a[href="/producto/${from[1]}"]`)
      ?.closest("[data-pcard]");
    if (!card || (card as HTMLElement).dataset.morph !== "1") return;
    setMorph(card.querySelector(".pcard__img"), "product-shot");
    setMorph(card.querySelector(".pcard__title"), "product-title");
  }

  // El enlace "‹ Catálogo" de la ficha: si llegamos desde un listado,
  // usamos history.back() → dirección "back" real (morph inverso + scroll
  // restaurado). Si se entró directo a la ficha, navega normal.
  function navBack(e: MouseEvent) {
    const el = (e.target as Element | null)?.closest?.("[data-nav-back]");
    if (!el) return;
    if ((window as any).__loirnFromList && history.length > 1) {
      e.preventDefault();
      history.back();
    }
  }

  if (!(window as any).__loirnMorphWired) {
    (window as any).__loirnMorphWired = true;
    // click fuera → cerrar tallas
    document.addEventListener("click", (e) => {
      const t = e.target as Element | null;
      if (!t?.closest("[data-picker]")) closeAllPickers();
    });
    document.addEventListener("astro:before-swap", closeAllPickers);
    document.addEventListener("click", (e) => armMorph(e.target), { capture: true });
    // por si el router dispara la navegación antes del click sintético
    document.addEventListener("pointerdown", (e) => armMorph(e.target), { capture: true });
    document.addEventListener("click", navBack, { capture: true });
    document.addEventListener("astro:before-swap", armBackMorph);
  }

  document.addEventListener("astro:page-load", wireCards);
</script>
