---
import { money } from "../data/products.js";
import type { Product } from "../data/products.js";

interface Props {
  product: Product;
  eager?: boolean;
  /** true = morph hacia la ficha (index/catálogo); false = tarjeta "relacionados" sin morph */
  share?: boolean;
}
const { product, eager = false, share = true } = Astro.props;
const href = `/producto/${product.slug}`;
// El morph hacia la ficha usa un nombre compartido (`product-shot` /
// `product-title`) que un script coloca sobre la card en la que se hace
// click. `share={false}` (relacionados) = sin morph, solo fundido.
const initials = product.collection
  .replace(/^LOIRN\s*/i, "")
  .trim()
  .charAt(0)
  .toUpperCase();
---

<article class="pcard" data-pcard data-morph={share ? "1" : "0"} data-images={JSON.stringify(product.images)}>
  <div class="pcard__stage">
    <div class="pcard__tools">
      <button class="icon-btn icon-btn--glass" type="button" aria-pressed="false" data-wish aria-label="Guardar en favoritos">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 21s-7.5-4.6-10-9A5.3 5.3 0 0 1 12 6a5.3 5.3 0 0 1 10 6c-2.5 4.4-10 9-10 9Z"></path>
        </svg>
      </button>
      <a class="icon-btn icon-btn--glass" href={href} aria-label="Ver prenda">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 15V4M8 8l4-4 4 4M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3"></path>
        </svg>
      </a>
    </div>

    <div class="pcard__orbit" aria-hidden="true"></div>

    <a href={href} class="pcard__frame" aria-label={`Ver ${product.name}`}>
      <img
        class="pcard__img"
        src={product.images[0]}
        alt={product.name}
        width="1100"
        height="1400"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </a>

    <div class="pcard__spin" role="group" aria-label="Cambiar vista">
      <button type="button" data-prev aria-label="Vista anterior">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m15 6-6 6 6 6"></path></svg>
      </button>
      <span class="pcard__spin-div"></span>
      <button type="button" data-next aria-label="Vista siguiente">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m9 6 6 6-6 6"></path></svg>
      </button>
    </div>

    {product.discountLabel && (
      <span class="badge-disc pcard__disc">{product.discountLabel}</span>
    )}
  </div>

  <div class="pcard__meta">
    <a href={href}>
      <h3 class="pcard__title">{product.name}</h3>
    </a>
    <div class="pcard__line pcard__line--b">
      <span class="seller">
        <span class="seller__avatar">{initials}</span>
        {product.collection}
      </span>
      <span class="pcard__prices">
        {product.compareAt && (
          <s class="pcard__was u-price">{money(product.compareAt)}</s>
        )}
        <span class="u-price pcard__now">{money(product.price)}</span>
      </span>
    </div>
  </div>

  <div class="pcard__actions">
    <a href={href} class="glass-pill pcard__size">
      Elegir talla
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m6 9 6 6 6-6"></path></svg>
    </a>
    <a href={href} class="icon-btn icon-btn--glass pcard__3d" aria-label="Vista 3D">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z"></path><path d="m3 7 9 5 9-5M12 12v10"></path>
      </svg>
    </a>
    <a href={href} class="btn pcard__add">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"></path></svg>
      Agregar
    </a>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: clamp(0.9rem, 2vw, 1.35rem);
    border-radius: var(--r-lg);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--sh-glass);
    backdrop-filter: blur(var(--glass-blur));
    transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease-out);
  }
  .pcard:hover {
    transform: translateY(-4px);
    box-shadow: 0 52px 90px -28px rgba(12, 12, 13, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }

  /* ---- Escenario del producto ---- */
  .pcard__stage {
    position: relative;
    border-radius: calc(var(--r-lg) - 8px);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0));
    padding: clamp(0.75rem, 2vw, 1.1rem);
    aspect-ratio: 5 / 6;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .pcard__tools {
    position: absolute;
    inset: clamp(0.75rem, 2vw, 1.1rem) clamp(0.75rem, 2vw, 1.1rem) auto;
    display: flex;
    justify-content: space-between;
    z-index: 3;
  }
  .pcard__frame { display: block; width: 84%; height: 100%; }
  .pcard__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 26px 30px rgba(12, 12, 13, 0.22));
    transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-3) var(--ease-out);
  }
  .pcard[data-busy] .pcard__img { opacity: 0; transform: scale(0.98); }

  /* órbita elíptica tras el producto */
  .pcard__orbit {
    position: absolute;
    left: 50%;
    top: 62%;
    width: 78%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border: 1px solid rgba(28, 28, 28, 0.28);
    border-radius: 50%;
    transform: scaleY(0.26) rotate(-2deg);
    z-index: 1;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
  }
  .pcard__frame { position: relative; z-index: 2; }

  /* pill de rotación ‹ › sobre la órbita */
  .pcard__spin {
    position: absolute;
    left: 50%;
    top: calc(62% + 2px);
    translate: -50% -50%;
    z-index: 4;
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: var(--r-pill);
    box-shadow: var(--sh-md);
    backdrop-filter: blur(8px);
  }
  .pcard__spin button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 34px;
    color: var(--loirn-ink);
    transition: background var(--dur-1) var(--ease-out);
    border-radius: var(--r-pill);
  }
  .pcard__spin button:hover { background: rgba(28, 28, 28, 0.08); }
  .pcard__spin-div { width: 1px; height: 16px; background: rgba(28, 28, 28, 0.18); }

  .pcard__disc {
    position: absolute;
    left: clamp(0.4rem, 1.5vw, 0.9rem);
    bottom: clamp(0.4rem, 1.5vw, 0.9rem);
    z-index: 4;
  }

  /* ---- Meta ---- */
  .pcard__meta {
    display: grid;
    gap: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid rgba(28, 28, 28, 0.1);
  }
  .pcard__line { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); }
  .pcard__title {
    font-size: clamp(2rem, 1.4rem + 2vw, 2.7rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 0.92;
  }
  .pcard__prices { display: inline-flex; align-items: baseline; gap: var(--sp-2); white-space: nowrap; }
  .pcard__was {
    color: var(--text-mute);
    font-size: var(--fs-300);
    text-decoration-thickness: 1px;
  }
  .pcard__now { font-size: clamp(1.9rem, 1.3rem + 2vw, 2.7rem); }

  /* ---- Acciones ---- */
  .pcard__actions {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--sp-2);
    align-items: center;
  }
  .pcard__size {
    justify-content: space-between;
    width: 100%;
    white-space: nowrap;
    font-size: var(--fs-200);
    padding-inline: 1em;
  }
  .pcard__add { padding-inline: 1.1em; white-space: nowrap; font-size: var(--fs-200); }

  @media (max-width: 420px) {
    .pcard__actions { grid-template-columns: 1fr auto; }
    .pcard__3d { display: none; }
  }
</style>

<script>
  // Rotación de vistas + favoritos. Se re-cablea tras cada navegación del ClientRouter.
  function wireCards() {
    document.querySelectorAll<HTMLElement>("[data-pcard]").forEach((card) => {
      if (card.dataset.wired) return;
      card.dataset.wired = "1";

      let imgs: string[] = [];
      try { imgs = JSON.parse(card.dataset.images || "[]"); } catch {}
      const img = card.querySelector<HTMLImageElement>(".pcard__img");

      if (img && imgs.length > 1) {
        let i = 0;
        imgs.forEach((src) => { const p = new Image(); p.src = src; });
        const go = (dir: number) => {
          i = (i + dir + imgs.length) % imgs.length;
          card.setAttribute("data-busy", "");
          const next = new Image();
          next.src = imgs[i];
          const swap = () => {
            img.src = imgs[i];
            requestAnimationFrame(() => card.removeAttribute("data-busy"));
          };
          next.complete
            ? setTimeout(swap, 160)
            : next.addEventListener("load", () => setTimeout(swap, 60));
        };
        card.querySelector("[data-prev]")?.addEventListener("click", () => go(-1));
        card.querySelector("[data-next]")?.addEventListener("click", () => go(1));
      }

      const wish = card.querySelector<HTMLButtonElement>("[data-wish]");
      wish?.addEventListener("click", () => {
        const on = wish.getAttribute("aria-pressed") === "true";
        wish.setAttribute("aria-pressed", String(!on));
        wish.classList.toggle("is-on", !on);
      });
    });
  }

  // Limpia el nombre de morph de una transición anterior (root: puede ser el
  // documento vivo o el documento entrante que aún no se ha insertado).
  function clearMorphNames(root: Document | Element = document) {
    root.querySelectorAll<HTMLElement>('[data-vt-morph]').forEach((el) => {
      el.style.removeProperty("view-transition-name");
      el.removeAttribute("data-vt-morph");
    });
  }
  function setMorph(el: Element | null | undefined, name: string) {
    if (!(el instanceof HTMLElement)) return;
    el.style.setProperty("view-transition-name", name);
    el.setAttribute("data-vt-morph", "");
  }

  // Antes de navegar a una ficha, marca la card clickeada con el nombre
  // compartido para que su foto y su título hagan "magic move". Fase de
  // captura → corre antes que el router. Las demás cards quedan fuera del
  // morph y se van con el fundido de la página.
  function armMorph(target: EventTarget | null) {
    const link = (target as Element | null)?.closest?.('a[href^="/producto/"]');
    if (!link) return;
    const card = link.closest<HTMLElement>('[data-pcard]');
    if (!card || card.dataset.morph !== "1") return;
    clearMorphNames();
    setMorph(card.querySelector(".pcard__img"), "product-shot");
    setMorph(card.querySelector(".pcard__title"), "product-title");
    (window as any).__loirnFromList = true; // llegamos a la ficha desde un listado
  }

  // Al VOLVER de una ficha a un listado: antes del swap, marca en el
  // documento entrante la card de esa prenda con el mismo nombre, para que
  // la foto de la ficha se "recoja" dentro de su card (morph inverso).
  function armBackMorph(e: any) {
    const from = e?.from?.pathname?.match(/^\/producto\/([^/]+)\/?$/);
    if (!from) return;
    if (/^\/producto\//.test(e?.to?.pathname || "")) return; // producto→producto no
    const doc: Document | undefined = e.newDocument;
    if (!doc) return;
    clearMorphNames(document);
    clearMorphNames(doc);
    const card = doc
      .querySelector(`[data-pcard] a[href="/producto/${from[1]}"]`)
      ?.closest("[data-pcard]");
    if (!card || (card as HTMLElement).dataset.morph !== "1") return;
    setMorph(card.querySelector(".pcard__img"), "product-shot");
    setMorph(card.querySelector(".pcard__title"), "product-title");
  }

  // El enlace "‹ Catálogo" de la ficha: si llegamos desde un listado,
  // usamos history.back() → dirección "back" real (morph inverso + scroll
  // restaurado). Si se entró directo a la ficha, navega normal.
  function navBack(e: MouseEvent) {
    const el = (e.target as Element | null)?.closest?.("[data-nav-back]");
    if (!el) return;
    if ((window as any).__loirnFromList && history.length > 1) {
      e.preventDefault();
      history.back();
    }
  }

  if (!(window as any).__loirnMorphWired) {
    (window as any).__loirnMorphWired = true;
    document.addEventListener("click", (e) => armMorph(e.target), { capture: true });
    // por si el router dispara la navegación antes del click sintético
    document.addEventListener("pointerdown", (e) => armMorph(e.target), { capture: true });
    document.addEventListener("click", navBack, { capture: true });
    document.addEventListener("astro:before-swap", armBackMorph);
  }

  document.addEventListener("astro:page-load", wireCards);
</script>
