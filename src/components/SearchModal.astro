---
import { getProducts } from "../lib/shop";

/**
 * Modal de búsqueda global. Catálogo serializado en build; la búsqueda
 * corre en cliente, sin fetch, con normalización de acentos.
 */
const products = await getProducts();
const catalog = products.map((p) => ({
  slug: p.slug,
  name: p.name,
  collection: p.collection,
  colorway: p.colorway,
  drop: p.drop,
  price: p.price,
  compareAt: p.compareAt,
  image: p.images[0] ?? "",
  href: `/producto/${p.slug}`,
}));
---

<div class="srch" data-search hidden role="dialog" aria-modal="true" aria-label="Buscar prendas">
  <div class="srch__scrim" data-search-close></div>

  <div class="srch__panel" data-search-panel>
    <div class="srch__bar">
      <svg class="srch__icon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <input
        class="srch__input"
        type="search"
        placeholder="Buscar prendas, colecciones…"
        autocomplete="off"
        spellcheck="false"
        data-search-input
        aria-label="Búsqueda"
      />
      <button type="button" class="icon-btn srch__close" data-search-close aria-label="Cerrar búsqueda">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="srch__body">
      <p class="srch__hint u-code" data-search-hint>Escribí una prenda, colección o colorway</p>
      <p class="srch__empty u-kicker" data-search-empty hidden>Sin resultados</p>
      <ul class="srch__results" data-search-results></ul>
    </div>
  </div>

  <script define:vars={{ catalog }}>
    window.__loirnSearchCatalog = catalog;
  </script>
</div>

<style>
  .srch {
    position: fixed; inset: 0; z-index: 400;
    display: flex; align-items: flex-start; justify-content: center;
    padding: clamp(1rem, 4vw, 3rem);
    padding-top: clamp(4rem, calc(var(--header-h) + 1.5rem), 8rem);
  }
  .srch[hidden] { display: none; }

  .srch__scrim {
    position: absolute; inset: 0;
    background: rgba(12, 12, 13, .72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .srch.is-open .srch__scrim { opacity: 1; }

  .srch__panel {
    position: relative; z-index: 1;
    width: 100%; max-width: 680px;
    display: flex; flex-direction: column;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-xl);
    box-shadow: var(--sh-glass);
    backdrop-filter: blur(var(--glass-blur));
    overflow: hidden;
    max-height: calc(100svh - var(--header-h) - 3rem);
    opacity: 0;
    transform: translateY(-10px) scale(.98);
    transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }
  .srch.is-open .srch__panel { opacity: 1; transform: none; }

  .srch__bar {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-5);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .srch__icon { color: var(--text-mute); flex-shrink: 0; }
  .srch__input {
    flex: 1; border: none; outline: none; background: transparent;
    font-family: var(--font-body); font-size: var(--fs-400); color: var(--text);
    line-height: 1.4; min-width: 0;
  }
  .srch__input::placeholder { color: var(--text-mute); }
  .srch__input::-webkit-search-cancel-button,
  .srch__input::-webkit-search-decoration { display: none; }
  .srch__close { width: 38px; height: 38px; flex-shrink: 0; }

  .srch__body { padding: var(--sp-4) var(--sp-5); overflow-y: auto; flex: 1; }
  .srch__hint { color: var(--text-mute); }
  .srch__empty { color: var(--text-mute); padding-block: var(--sp-4); }

  .srch__results { display: grid; gap: var(--sp-2); }

  /* Los resultados se inyectan por JS: no llevan el atributo de scope de
     Astro, así que sus reglas van con :global() colgando de .srch__results
     (mismo patrón que CartDrawer.astro). */
  .srch__results :global(.srch-item) {
    display: flex; align-items: center; gap: var(--sp-4);
    padding: var(--sp-3); border-radius: var(--r-md);
    border: 1px solid transparent;
    transition: background var(--dur-1) var(--ease-out), border-color var(--dur-1) var(--ease-out);
    text-decoration: none; color: inherit;
  }
  .srch__results :global(.srch-item:hover),
  .srch__results :global(.srch-item:focus-visible) {
    background: rgba(255,255,255,.55); border-color: var(--border); outline: none;
  }
  .srch__results :global(.srch-item__img-wrap) {
    width: 60px; height: 76px; flex-shrink: 0;
    border-radius: var(--r-sm);
    background: linear-gradient(180deg, rgba(255,255,255,.8), rgba(232,233,235,.4));
    border: 1px solid var(--border);
    display: grid; place-items: center; overflow: hidden;
  }
  .srch__results :global(.srch-item__img) { width: 82%; height: 100%; object-fit: contain; }
  .srch__results :global(.srch-item__info) { flex: 1; display: grid; gap: 2px; min-width: 0; }
  .srch__results :global(.srch-item__collection) {
    font-family: var(--font-label); text-transform: uppercase;
    letter-spacing: .08em; font-size: var(--fs-100); color: var(--text-mute);
  }
  .srch__results :global(.srch-item__name) {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.2rem, .8rem + 1.2vw, 1.6rem);
    line-height: .95; letter-spacing: var(--tracking-display); text-transform: uppercase;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .srch__results :global(.srch-item__prices) { display: flex; align-items: baseline; gap: var(--sp-2); }
  .srch__results :global(.srch-item__was) { color: var(--text-mute); font-size: var(--fs-200); text-decoration: line-through; }
  .srch__results :global(.srch-item__now) { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.1rem, .8rem + .8vw, 1.4rem); }
  .srch__results :global(.srch-item__arr) { color: var(--text-mute); flex-shrink: 0; }
  .srch__results :global(.srch-item:hover .srch-item__arr),
  .srch__results :global(.srch-item:focus-visible .srch-item__arr) { color: var(--text); }

  @media (max-width: 480px) {
    .srch { padding: .75rem; padding-top: clamp(3.5rem, calc(var(--header-h) + .5rem), 6rem); }
    .srch__panel { border-radius: var(--r-lg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .srch__scrim, .srch__panel { transition: none; }
  }
</style>

<script>
  import { money } from "../lib/shop/money";

  interface SearchItem {
    slug: string; name: string; collection: string;
    colorway: string; drop: string;
    price: number; compareAt: number | null;
    image: string; href: string;
  }

  let catalog: SearchItem[] = [];

  function loadCatalog() {
    catalog = ((window as any).__loirnSearchCatalog as SearchItem[]) ?? [];
  }

  const norm = (s: string): string =>
    s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

  function score(item: SearchItem, tokens: string[]): number {
    const name = norm(item.name);
    const col = norm(item.collection);
    const cw = norm(item.colorway);
    const drop = norm(item.drop);
    let s = 0;
    for (const t of tokens) {
      if (name.includes(t)) s += 3;
      else if (col.includes(t)) s += 2;
      else if (cw.includes(t)) s += 2;
      else if (drop.includes(t)) s += 1;
      else return 0;
    }
    return s;
  }

  function search(q: string): SearchItem[] {
    if (!q.trim()) return [];
    const tokens = norm(q).split(/\s+/).filter(Boolean);
    return catalog
      .map((item) => ({ item, s: score(item, tokens) }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 8)
      .map((x) => x.item);
  }

  const esc = (s: string) =>
    String(s).replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string
    );

  function renderResults(results: SearchItem[], hasQuery: boolean) {
    const list = document.querySelector<HTMLElement>("[data-search-results]");
    const hint = document.querySelector<HTMLElement>("[data-search-hint]");
    const empty = document.querySelector<HTMLElement>("[data-search-empty]");
    if (!list || !hint || !empty) return;

    if (!hasQuery) {
      hint.hidden = false; empty.hidden = true; list.innerHTML = ""; return;
    }
    hint.hidden = true;
    if (results.length === 0) {
      empty.hidden = false; list.innerHTML = ""; return;
    }
    empty.hidden = true;
    list.innerHTML = results.map((p) => `
      <li>
        <a class="srch-item" href="${esc(p.href)}" data-search-close>
          <div class="srch-item__img-wrap">
            <img class="srch-item__img" src="${esc(p.image)}" alt="" width="120" height="152" loading="lazy" decoding="async"/>
          </div>
          <div class="srch-item__info">
            <p class="srch-item__collection">${esc(p.collection)}</p>
            <p class="srch-item__name">${esc(p.name)}</p>
            <div class="srch-item__prices">
              ${p.compareAt ? `<s class="srch-item__was">${money(p.compareAt)}</s>` : ""}
              <span class="srch-item__now">${money(p.price)}</span>
            </div>
          </div>
          <svg class="srch-item__arr" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg>
        </a>
      </li>
    `).join("");
  }

  let lastFocus: HTMLElement | null = null;

  function open() {
    const el = document.querySelector<HTMLElement>("[data-search]");
    if (!el || el.classList.contains("is-open")) return;
    loadCatalog();
    lastFocus = document.activeElement as HTMLElement | null;
    el.hidden = false;
    document.body.style.overflow = "hidden";
    void el.offsetWidth;
    el.classList.add("is-open");
    requestAnimationFrame(() => {
      document.querySelector<HTMLInputElement>("[data-search-input]")?.focus();
    });
  }

  function close() {
    const el = document.querySelector<HTMLElement>("[data-search]");
    if (!el || el.hidden) return;
    el.classList.remove("is-open");
    document.body.style.overflow = "";
    const hide = () => { el.hidden = true; };
    matchMedia("(prefers-reduced-motion: reduce)").matches ? hide() : setTimeout(hide, 280);
    const input = document.querySelector<HTMLInputElement>("[data-search-input]");
    if (input) { input.value = ""; renderResults([], false); }
    lastFocus?.focus();
  }

  function onKey(e: KeyboardEvent) {
    const el = document.querySelector<HTMLElement>("[data-search]");
    if (!el || el.hidden) return;
    if (e.key === "Escape") { close(); return; }
    if (e.key !== "Tab") return;
    const items = el.querySelectorAll<HTMLElement>(
      'a[href], button:not(:disabled), input, [tabindex]:not([tabindex="-1"])'
    );
    if (!items.length) return;
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }

  function wireInput() {
    const input = document.querySelector<HTMLInputElement>("[data-search-input]");
    if (input && !input.dataset.wired) {
      input.dataset.wired = "1";
      input.addEventListener("input", () => {
        const q = input.value;
        renderResults(search(q), q.trim().length > 0);
      });
    }
  }

  if (!(window as any).__loirnSearchWired) {
    (window as any).__loirnSearchWired = true;

    document.addEventListener("keydown", onKey);
    document.addEventListener("astro:before-swap", () => {
      close();
      document.body.style.overflow = "";
    });

    document.addEventListener("click", (e) => {
      const t = e.target as Element | null;
      if (!t) return;
      if (t.closest("[data-search-open]")) { e.preventDefault(); open(); return; }
      if (t.closest("[data-search-close]")) { close(); return; }
    });
  }

  document.addEventListener("astro:page-load", wireInput);
</script>
