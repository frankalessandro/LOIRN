---
import logo from "../assets/loirn-logo.png";

const links = [
  { label: "Home", href: "/" },
  { label: "Catálogo", href: "/catalogo" },
  { label: "Drops", href: "/drops" },
  { label: "El local", href: "/local" },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header" data-header transition:name="site-header">
  <div class="site-header__inner wrap">
    <nav class="nav nav--left" aria-label="Principal">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={["nav__link", { "is-active": isActive(l.href) }]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <a href="/" class="header-brand-hit" aria-label="LOIRN — inicio"></a>

    <div class="header-brand" aria-hidden="true">
      <img src={logo.src} width={logo.width} height={logo.height} alt="" />
    </div>

    <nav class="nav nav--right" aria-label="Utilidades">
      <button type="button" class="nav__link nav__link--icon" data-search-open aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </button>
      <a href="/favoritos" class="nav__link nav__link--icon" aria-label="Favoritos">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 21s-7.5-4.6-10-9A5.3 5.3 0 0 1 12 6a5.3 5.3 0 0 1 10 6c-2.5 4.4-10 9-10 9Z"></path>
        </svg>
        <span class="nav__badge" data-wish-badge hidden>0</span>
      </a>
      <button type="button" class="nav__link nav__cart" data-cart-open aria-label="Abrir carrito">
        Cart <span data-cart-count aria-hidden="true">(0)</span>
        <span class="nav__badge" data-cart-badge hidden>0</span>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    /* fondo aparece con el scroll (var --p la fija Layout) */
    background: rgba(12, 12, 13, calc(var(--p) * 0.82));
    backdrop-filter: blur(calc(var(--p) * 16px));
    border-bottom: 1px solid rgba(235, 236, 236, calc(var(--p) * 0.14));
    transition: background 0.25s linear, border-color 0.25s linear;
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-h);
    gap: var(--sp-4);
  }

  .nav { display: flex; align-items: center; gap: clamp(0.9rem, 2vw, 2rem); }
  .nav--right { justify-content: flex-end; }

  .nav__link {
    font-family: var(--font-label);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: var(--fs-200);
    color: rgba(235, 236, 236, 0.72);
    padding-block: 0.4em;
    transition: color var(--dur-1) var(--ease-out);
  }
  .nav__link:hover,
  .nav__link.is-active { color: var(--loirn-paper); }
  .nav__link.is-active { text-decoration: underline; text-underline-offset: 6px; }

  /* Botones icono (buscar, favoritos) — mismo trato de pill que el resto del sitio. */
  .nav__link--icon {
    position: relative;
    display: inline-grid; place-items: center;
    width: 38px; height: 38px;
    border-radius: var(--r-pill);
    transition: background var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .nav__link--icon:hover { background: rgba(235, 236, 236, 0.1); }

  .nav__cart {
    position: relative; display: inline-flex; align-items: center; gap: .4em;
    padding: .5em .9em; border-radius: var(--r-pill);
    transition: background var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .nav__cart:hover { background: rgba(235, 236, 236, 0.1); }
  .nav__cart [data-cart-count] { color: rgba(235, 236, 236, 0.5); }

  /* Badge numérico (favoritos / carrito) — mismo componente, distinto ancla. */
  .nav__badge {
    position: absolute;
    top: -2px; right: -4px;
    min-width: 17px; height: 17px;
    padding-inline: 4px;
    display: grid; place-items: center;
    border-radius: var(--r-pill);
    background: var(--loirn-paper);
    color: var(--loirn-black);
    font-family: var(--font-mono);
    font-size: 10px; line-height: 1; letter-spacing: 0;
  }
  .nav__badge[hidden] { display: none; }
  .nav__cart .nav__badge { top: -2px; right: -6px; }

  /* Marca ÚNICA. Parte gigante y centrada sobre el héroe (--p:0) y se
     encoge + sube hasta encajar en la barra (--p:1). En páginas sin héroe
     Layout fija --p:1, así que aparece directamente en su sitio.
     .header-brand-hit reserva el hueco en la grilla y es el enlace real. */
  .header-brand-hit {
    display: block;
    width: var(--brand-w1);
    height: 26px;
    --brand-w1: 48px;
  }

  .header-brand {
    --brand-w0: min(72vw, 900px); /* tamaño imponente inicial */
    --brand-w1: 48px;             /* tamaño final en la barra  */
    position: fixed;
    top: 0;
    left: 50%;
    z-index: 101;
    pointer-events: none;
    transform:
      translate(-50%, -50%)
      translateY(
        calc(
          var(--header-h) / 2 +
          (50svh - 6vh - var(--header-h) / 2) * (1 - var(--p))
        )
      );
    will-change: transform;
  }
  .header-brand img {
    display: block;
    width: calc(
      var(--brand-w1) + (var(--brand-w0) - var(--brand-w1)) * (1 - var(--p))
    );
    height: auto;
    filter: drop-shadow(
      0
      calc(2px + 16px * (1 - var(--p)))
      calc(6px + 44px * (1 - var(--p)))
      rgba(0, 0, 0, calc(0.35 + 0.15 * (1 - var(--p))))
    );
  }

  @media (max-width: 720px) {
    .header-brand { --brand-w0: 88vw; }
  }

  @media (max-width: 640px) {
    .nav__cart [data-cart-count] { display: none; }
    .nav__cart .nav__badge { right: -2px; }
    .nav { gap: 0.9rem; }
    .header-brand-hit { width: 42px; --brand-w1: 42px; }
    .header-brand { --brand-w1: 42px; }
  }
</style>
