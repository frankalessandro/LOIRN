---
/**
 * Carrito lateral. Se monta una vez en Layout, así está en todas las páginas.
 * El contenido se pinta en cliente desde `src/lib/cart/store.ts`.
 */
import { money } from "../lib/shop";
---

<div class="cart" data-cart hidden>
  <div class="cart__scrim" data-cart-close></div>

  <aside
    class="cart__panel"
    role="dialog"
    aria-modal="true"
    aria-label="Carrito de compra"
    data-cart-panel
  >
    <header class="cart__head">
      <p class="u-kicker">Tu carrito <span data-cart-count>(0)</span></p>
      <button type="button" class="icon-btn" data-cart-close aria-label="Cerrar carrito">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"></path></svg>
      </button>
    </header>

    <div class="cart__ship" data-cart-ship hidden>
      <p class="u-code" data-cart-ship-label></p>
      <div class="cart__ship-track"><span data-cart-ship-bar></span></div>
    </div>

    <div class="cart__body">
      <ul class="cart__lines" data-cart-lines></ul>

      <div class="cart__empty" data-cart-empty>
        <p class="u-kicker">Todavía está vacío</p>
        <h3>Nada que<br />mostrar</h3>
        <p class="u-lede">Elegí una prenda del sistema y armá tu presencia.</p>
        <a href="/catalogo" class="btn" data-cart-close>Ver catálogo</a>
      </div>
    </div>

    <footer class="cart__foot" data-cart-foot hidden>
      <div class="cart__row">
        <span class="u-kicker">Subtotal</span>
        <span class="u-price cart__total" data-cart-total>{money(0)}</span>
      </div>
      <p class="cart__save" data-cart-save hidden></p>
      <p class="u-code cart__note">Impuestos y envío se calculan en el pago.</p>
      <button type="button" class="btn btn--lg btn--block" data-cart-checkout>
        <span data-cart-checkout-label>Finalizar compra</span>
      </button>
      <p class="cart__err" data-cart-error hidden></p>
      <button type="button" class="cart__clear" data-cart-clear>Vaciar carrito</button>
    </footer>
  </aside>
</div>

<style>
  .cart { position: fixed; inset: 0; z-index: 300; }
  .cart[hidden] { display: none; }

  .cart__scrim {
    position: absolute; inset: 0;
    background: rgba(12, 12, 13, 0.55);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .cart.is-open .cart__scrim { opacity: 1; }

  .cart__panel {
    position: absolute; inset: 0 0 0 auto;
    width: min(460px, 100%);
    display: flex; flex-direction: column;
    background: var(--bg);
    box-shadow: var(--sh-lg);
    transform: translateX(100%);
    transition: transform var(--dur-3) var(--ease-out);
  }
  .cart.is-open .cart__panel { transform: none; }

  .cart__head {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--sp-5) var(--sp-5) var(--sp-4);
    border-bottom: 1px solid var(--border);
  }
  .cart__head .u-kicker span { color: var(--text-mute); }

  /* ---- barra de envío gratis ---- */
  .cart__ship { padding: var(--sp-4) var(--sp-5) 0; display: grid; gap: var(--sp-2); }
  .cart__ship[hidden] { display: none; }
  .cart__ship p { color: var(--text-soft); }
  .cart__ship-track {
    height: 3px; border-radius: var(--r-pill);
    background: rgba(28, 28, 28, 0.12); overflow: hidden;
  }
  .cart__ship-track span {
    display: block; height: 100%; width: 0;
    background: var(--loirn-ink);
    transition: width var(--dur-3) var(--ease-out);
  }

  .cart__body { flex: 1; overflow-y: auto; padding: var(--sp-5); }

  .cart__lines { display: grid; gap: var(--sp-5); }
  .cart__lines:empty { display: none; }

  /* Las líneas se inyectan por JS, así que no llevan el atributo de scope de
     Astro: sus reglas van con :global() colgando del contenedor scopeado. */
  .cart__lines :global(.cart__line) { display: grid; grid-template-columns: 84px 1fr; gap: var(--sp-4); }
  .cart__lines :global(.cart__line-shot) {
    aspect-ratio: 5 / 6;
    border-radius: var(--r-sm);
    background: var(--surface);
    display: grid; place-items: center;
    overflow: hidden;
  }
  .cart__lines :global(.cart__line-shot img) { width: 100%; height: 100%; object-fit: contain; }
  .cart__lines :global(.cart__line-main) { display: grid; gap: var(--sp-2); align-content: start; }
  .cart__lines :global(.cart__line-top) {
    display: flex; align-items: start; justify-content: space-between; gap: var(--sp-3);
  }
  .cart__lines :global(.cart__line-name) {
    font-family: var(--font-display); font-weight: 600; text-transform: uppercase;
    font-size: var(--fs-500); line-height: 0.92;
  }
  .cart__lines :global(.cart__line-size) {
    font-family: var(--font-label); text-transform: uppercase;
    letter-spacing: 0.12em; font-size: var(--fs-100); color: var(--text-mute);
  }
  .cart__lines :global(.cart__line-del) {
    color: var(--text-mute); line-height: 1; font-size: 1.4rem;
    transition: color var(--dur-1) var(--ease-out);
  }
  .cart__lines :global(.cart__line-del:hover) { color: var(--text); }
  .cart__lines :global(.cart__line-bot) {
    display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3);
  }
  .cart__lines :global(.cart__line-price) { font-size: var(--fs-400); }

  .cart__lines :global(.qty) {
    display: inline-flex; align-items: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
  }
  .cart__lines :global(.qty button) {
    width: 32px; height: 30px; display: grid; place-items: center;
    color: var(--text-soft); border-radius: var(--r-pill);
    transition: background var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .cart__lines :global(.qty button:hover:not(:disabled)) { background: rgba(28, 28, 28, 0.07); color: var(--text); }
  .cart__lines :global(.qty button:disabled) { opacity: 0.35; cursor: not-allowed; }
  .cart__lines :global(.qty output) {
    min-width: 2ch; text-align: center;
    font-family: var(--font-mono); font-size: var(--fs-100);
    font-variant-numeric: tabular-nums;
  }

  /* ---- vacío ---- */
  .cart__empty { display: grid; gap: var(--sp-3); justify-items: start; padding-top: var(--sp-6); }
  .cart__empty h3 { font-size: var(--fs-600); line-height: 0.86; }
  .cart__empty .btn { margin-top: var(--sp-3); }
  .cart__empty[hidden] { display: none; }

  /* ---- pie ---- */
  .cart__foot {
    border-top: 1px solid var(--border);
    padding: var(--sp-5);
    display: grid; gap: var(--sp-3);
    background: var(--bg-raised);
  }
  .cart__foot[hidden] { display: none; }
  .cart__row { display: flex; align-items: baseline; justify-content: space-between; }
  .cart__total { font-size: var(--fs-500); }
  .cart__save {
    font-family: var(--font-label); text-transform: uppercase;
    letter-spacing: 0.1em; font-size: var(--fs-100); color: var(--text-soft);
  }
  .cart__save[hidden] { display: none; }
  .cart__note { color: var(--text-mute); }
  .cart__err { font-size: var(--fs-200); color: #9b2c2c; }
  .cart__err[hidden] { display: none; }
  .cart__clear {
    justify-self: center;
    font-family: var(--font-label); text-transform: uppercase;
    letter-spacing: 0.12em; font-size: var(--fs-100); color: var(--text-mute);
    text-decoration: underline; text-underline-offset: 4px;
  }
  .cart__clear:hover { color: var(--text); }

  @media (prefers-reduced-motion: reduce) {
    .cart__panel, .cart__scrim { transition: none; }
  }
</style>

<script>
  import {
    subscribe, getCart, addLine, setQuantity, removeLine, clearCart,
    cartCount, cartSubtotal, cartSavings,
  } from "../lib/cart/store";
  import { createCheckoutUrl, checkoutMode } from "../lib/cart/checkout";
  import { money } from "../lib/shop/money";

  /** Envío gratis — mismo umbral que promete la ficha de producto. */
  const FREE_SHIPPING = 250000;

  const esc = (s: string) =>
    String(s).replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string
    );

  /** Pinta el drawer y todos los contadores presentes en la página. */
  function render() {
    const state = getCart();
    const n = cartCount(state);
    const subtotal = cartSubtotal(state);

    document.querySelectorAll("[data-cart-count]").forEach((el) => {
      el.textContent = `(${n})`;
    });
    document.querySelectorAll<HTMLElement>("[data-cart-badge]").forEach((el) => {
      el.textContent = String(n);
      el.hidden = n === 0;
    });

    const list = document.querySelector<HTMLUListElement>("[data-cart-lines]");
    if (!list) return;

    const empty = document.querySelector<HTMLElement>("[data-cart-empty]");
    const foot = document.querySelector<HTMLElement>("[data-cart-foot]");
    if (empty) empty.hidden = n > 0;
    if (foot) foot.hidden = n === 0;

    list.innerHTML = state.lines
      .map(
        (l) => `
        <li class="cart__line" data-variant="${esc(l.variantId)}">
          <a class="cart__line-shot" href="/producto/${esc(l.productSlug)}" data-cart-close>
            <img src="${esc(l.image)}" alt="" width="180" height="216" loading="lazy" decoding="async">
          </a>
          <div class="cart__line-main">
            <div class="cart__line-top">
              <div>
                <a href="/producto/${esc(l.productSlug)}" data-cart-close>
                  <p class="cart__line-name">${esc(l.name)}</p>
                </a>
                <p class="cart__line-size">Talla ${esc(l.size)}</p>
              </div>
              <button type="button" class="cart__line-del" data-line-remove aria-label="Quitar ${esc(l.name)}">&times;</button>
            </div>
            <div class="cart__line-bot">
              <div class="qty">
                <button type="button" data-line-dec aria-label="Quitar una unidad"${l.quantity <= 1 ? " disabled" : ""}>&minus;</button>
                <output aria-label="Cantidad">${l.quantity}</output>
                <button type="button" data-line-inc aria-label="Añadir una unidad">+</button>
              </div>
              <span class="u-price cart__line-price">${money(l.price * l.quantity)}</span>
            </div>
          </div>
        </li>`
      )
      .join("");

    const total = document.querySelector("[data-cart-total]");
    if (total) total.textContent = money(subtotal);

    const saved = cartSavings(state);
    const save = document.querySelector<HTMLElement>("[data-cart-save]");
    if (save) {
      save.hidden = saved <= 0;
      save.textContent = `Ahorrás ${money(saved)}`;
    }

    const ship = document.querySelector<HTMLElement>("[data-cart-ship]");
    const shipLabel = document.querySelector<HTMLElement>("[data-cart-ship-label]");
    const shipBar = document.querySelector<HTMLElement>("[data-cart-ship-bar]");
    if (ship && shipLabel && shipBar) {
      ship.hidden = n === 0;
      const missing = FREE_SHIPPING - subtotal;
      shipLabel.textContent =
        missing > 0
          ? `Te faltan ${money(missing)} para envío gratis`
          : "Envío gratis desbloqueado";
      shipBar.style.width = `${Math.min(100, (subtotal / FREE_SHIPPING) * 100)}%`;
    }

    const label = document.querySelector("[data-cart-checkout-label]");
    if (label && !label.hasAttribute("data-busy")) {
      label.textContent =
        checkoutMode === "shopify" ? "Finalizar compra" : "Pedir por WhatsApp";
    }
  }

  // ---- apertura / cierre ----
  let lastFocus: HTMLElement | null = null;

  function open() {
    const el = document.querySelector<HTMLElement>("[data-cart]");
    if (!el || el.classList.contains("is-open")) return;
    lastFocus = document.activeElement as HTMLElement | null;
    el.hidden = false;
    document.body.style.overflow = "hidden";
    // Reflow forzado: arranca la transición sin depender de rAF (que no corre
    // en pestañas en segundo plano y dejaría el panel fuera de pantalla).
    void el.offsetWidth;
    el.classList.add("is-open");
    el.querySelector<HTMLElement>("[data-cart-close]")?.focus();
  }

  function close() {
    const el = document.querySelector<HTMLElement>("[data-cart]");
    if (!el || el.hidden) return;
    el.classList.remove("is-open");
    document.body.style.overflow = "";
    const hide = () => { el.hidden = true; };
    matchMedia("(prefers-reduced-motion: reduce)").matches ? hide() : setTimeout(hide, 320);
    lastFocus?.focus();
  }

  /** Escape cierra; Tab queda atrapado dentro del panel. */
  function onKey(e: KeyboardEvent) {
    const el = document.querySelector<HTMLElement>("[data-cart]");
    if (!el || el.hidden) return;
    if (e.key === "Escape") { close(); return; }
    if (e.key !== "Tab") return;
    const items = el.querySelectorAll<HTMLElement>(
      'a[href], button:not(:disabled), [tabindex]:not([tabindex="-1"])'
    );
    if (!items.length) return;
    const first = items[0] as HTMLElement;
    const last = items[items.length - 1] as HTMLElement;
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }

  async function checkout(btn: HTMLButtonElement) {
    const err = document.querySelector<HTMLElement>("[data-cart-error]");
    const label = document.querySelector<HTMLElement>("[data-cart-checkout-label]");
    if (err) err.hidden = true;
    btn.disabled = true;
    label?.setAttribute("data-busy", "");
    if (label) label.textContent = "Preparando…";
    try {
      location.href = await createCheckoutUrl(getCart().lines);
    } catch (e) {
      if (err) {
        err.hidden = false;
        err.textContent =
          e instanceof Error ? e.message : "No pudimos abrir el pago. Intentá de nuevo.";
      }
      btn.disabled = false;
      label?.removeAttribute("data-busy");
      render();
    }
  }

  // Delegación global: sobrevive a los cambios de página del ClientRouter.
  if (!(window as any).__loirnCartWired) {
    (window as any).__loirnCartWired = true;

    subscribe(render);
    window.addEventListener("loirn:cart:open", open);
    window.addEventListener("loirn:cart:close", close);
    document.addEventListener("keydown", onKey);
    // Al navegar se reemplaza el DOM del drawer: soltar el bloqueo de scroll.
    document.addEventListener("astro:before-swap", () => {
      document.body.style.overflow = "";
    });

    document.addEventListener("click", (e) => {
      const t = e.target as Element | null;
      if (!t) return;

      if (t.closest("[data-cart-open]")) { e.preventDefault(); open(); return; }
      if (t.closest("[data-cart-close]")) { close(); return; }

      // Cualquier elemento con [data-add-to-cart] y un [data-line] con la
      // línea serializada añade al carrito. Lo usan la tarjeta y la ficha.
      const addBtn = t.closest<HTMLElement>("[data-add-to-cart]");
      if (addBtn) {
        e.preventDefault();
        let line;
        try { line = JSON.parse(addBtn.dataset.line || ""); } catch { return; }
        if (!line) return;
        addLine(line);
        addBtn.classList.add("is-added");
        setTimeout(() => addBtn.classList.remove("is-added"), 1400);
        open();
        return;
      }

      const id = t.closest<HTMLElement>("[data-variant]")?.dataset.variant;
      if (id) {
        const qty = getCart().lines.find((l) => l.variantId === id)?.quantity ?? 0;
        if (t.closest("[data-line-inc]")) { setQuantity(id, qty + 1); return; }
        if (t.closest("[data-line-dec]")) { setQuantity(id, Math.max(1, qty - 1)); return; }
        if (t.closest("[data-line-remove]")) { removeLine(id); return; }
      }

      if (t.closest("[data-cart-clear]")) { clearCart(); return; }

      const pay = t.closest<HTMLButtonElement>("[data-cart-checkout]");
      if (pay) { checkout(pay); return; }
    });
  }

  document.addEventListener("astro:page-load", render);
  render();
</script>
