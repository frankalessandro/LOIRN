---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getProducts, money } from "../../lib/shop";
import type { Product, ProductVariant } from "../../lib/shop";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({
    params: { slug: p.slug },
    props: { product: p, related: products.filter((x) => x.slug !== p.slug).slice(0, 3) },
  }));
}
const { product, related } = Astro.props as { product: Product; related: Product[] };
const oneSize = product.variants.length === 1;
const soldOut = !product.availableForSale;

/** Línea de carrito serializada por variante — la lee el handler global. */
const line = (v: ProductVariant) =>
  JSON.stringify({
    variantId: v.id,
    productSlug: product.slug,
    name: product.name,
    size: v.size,
    price: v.price,
    compareAt: v.compareAtPrice,
    image: product.images[0],
  });

const accordions = [
  { t: "Detalles del producto", items: product.details },
  {
    t: "Guía de tallas",
    items: [
      "Corte urbano contemporáneo. Si dudas entre dos, elige la menor para fit ajustado.",
      "Modelo 1.80 m usa talla M.",
      "Medidas exactas disponibles por chat de asesoría.",
    ],
  },
  {
    t: "Envíos y devoluciones",
    items: [
      "Envío a toda Colombia 2–5 días hábiles. Gratis desde $250.000.",
      "Cambios sin costo dentro de 15 días.",
      "Recogida en tienda disponible.",
    ],
  },
];
---

<Layout title={`${product.name} — LOIRN`} nav="solid">
  <div class="pdp wrap">
    <!-- móvil: arriba de la galería (nada es sticky en una columna) -->
    <a href="/catalogo" class="pdp__back pdp__back--top" data-nav-back>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m15 6-6 6 6 6"></path></svg>
      Catálogo
    </a>

    <div class="pdp__layout">
      <!-- INFO (sticky · izquierda en desktop) -->
      <aside class="pdp__info">
        <!-- ≥700px: dentro de la columna sticky, así no se va con el scroll -->
        <a href="/catalogo" class="pdp__back pdp__back--side" data-nav-back>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m15 6-6 6 6 6"></path></svg>
          Catálogo
        </a>
        <p class="u-code">{product.drop} · {product.sku}</p>
        <h1 class="pdp__title" transition:name="product-title">{product.name}</h1>
        <div class="pdp__price">
          <span class="u-price pdp__now">{money(product.price)}</span>
          {product.compareAt && <s class="u-price pdp__was">{money(product.compareAt)}</s>}
          {product.discountLabel && <span class="badge-disc">{product.discountLabel}</span>}
        </div>
        <p class="u-lede pdp__desc">{product.description}</p>
        <p class="pdp__colorway"><span class="u-kicker">Colorway</span> {product.colorway}</p>

        <div class="pdp__accordions">
          {accordions.map((a, i) => (
            <details open={i === 0}>
              <summary>
                {a.t}
                <svg class="acc-ico" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg>
              </summary>
              <ul>{a.items.map((it) => <li>{it}</li>)}</ul>
            </details>
          ))}
        </div>
      </aside>

      <!-- GALERÍA (única columna que se desplaza) -->
      <div class="pdp__gallery" data-gallery>
        {[...product.images, ...product.images.slice(0, 2)].map((src, i) =>
          i === 0 ? (
            <figure class="pdp__shot">
              <img
                src={src} alt={`${product.name} — vista 1`}
                width="1100" height="1400" fetchpriority="high" decoding="async"
                transition:name="product-shot"
              />
            </figure>
          ) : (
            <figure class="pdp__shot">
              <img
                src={src} alt={`${product.name} — vista ${i + 1}`}
                width="1100" height="1400" loading="lazy" decoding="async"
              />
            </figure>
          )
        )}
      </div>

      <!-- COMPRA (sticky · derecha en desktop) -->
      <aside class="pdp__buy">
        <div class="pdp__buy-inner">
          <div class="pdp__sizes" role="radiogroup" aria-label="Talla">
            <div class="pdp__sizes-head">
              <span class="u-kicker">Talla</span>
              {!oneSize && <button type="button" class="pdp__guide" data-open-guide>Guía</button>}
            </div>
            <div class="pdp__size-grid" data-sizes>
              {product.variants.map((v, i) => (
                <button
                  type="button" role="radio"
                  aria-checked={oneSize && i === 0 ? "true" : "false"}
                  class:list={["pdp__size", { "is-on": oneSize && i === 0 }]}
                  data-size={v.size}
                  data-line={line(v)}
                  disabled={!v.availableForSale}
                  aria-label={v.availableForSale ? `Talla ${v.size}` : `Talla ${v.size} agotada`}
                >{v.size}</button>
              ))}
            </div>
          </div>

          <button
            type="button"
            class="btn btn--lg btn--block pdp__add"
            data-add
            data-add-to-cart
            data-line={oneSize && product.variants[0] ? line(product.variants[0]) : undefined}
            disabled={soldOut || !oneSize}
          >
            <span data-add-label>
              {soldOut ? "Agotado" : oneSize ? "Agregar al carrito" : "Elige una talla"}
            </span>
          </button>

          <div class="pdp__mini">
            <button type="button" class="glass-pill" data-wish>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7.5-4.6-10-9A5.3 5.3 0 0 1 12 6a5.3 5.3 0 0 1 10 6c-2.5 4.4-10 9-10 9Z"></path></svg>
              Guardar
            </button>
            <button type="button" class="glass-pill" data-share>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15V4M8 8l4-4 4 4M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3"></path></svg>
              Compartir
            </button>
          </div>

          <p class="pdp__ship u-code">Envío a toda Colombia · Cambios 15 días · Hecho en Colombia</p>
        </div>
      </aside>
    </div>
  </div>

  <section class="section wrap">
    <div class="section-head" data-reveal>
      <div><p class="u-kicker">Combina con</p><h2>Completa el look</h2></div>
      <a class="btn btn--ghost" href="/catalogo">Ver todo</a>
    </div>
    <div class="pgrid">
      {related.map((p) => <div data-reveal><ProductCard product={p} share={false} /></div>)}
    </div>
  </section>

  <div class="pdp__bar" data-buybar hidden>
    <div class="wrap pdp__bar-inner">
      <div>
        <p class="pdp__bar-name">{product.name}</p>
        <p class="u-price pdp__bar-price">{money(product.price)}</p>
      </div>
      <button
        type="button"
        class="btn"
        data-add-mirror
        data-add-to-cart
        data-line={oneSize && product.variants[0] ? line(product.variants[0]) : undefined}
        disabled={soldOut || !oneSize}
      >{soldOut ? "Agotado" : "Agregar"}</button>
    </div>
  </div>
</Layout>

<style>
  .pdp {
    /* Se reusa en el alto de la vista partida (≥700px) y en el `top` de lo fijo. */
    --pdp-top: calc(var(--header-h) + clamp(1rem, 3vw, 2rem));
    padding-top: var(--pdp-top);
  }
  .pdp__back {
    display: inline-flex; align-items: center; gap: 0.4em;
    font-family: var(--font-label); text-transform: uppercase;
    letter-spacing: 0.14em; font-size: var(--fs-200); color: var(--text-soft);
    margin-bottom: var(--sp-5);
  }
  .pdp__back:hover { color: var(--text); }
  .pdp__back--side { display: none; }
  @media (min-width: 700px) {
    .pdp__back--top { display: none; }
    .pdp__back--side { display: inline-flex; }
  }

  .pdp__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  /* ---- Columnas sticky ---- */
  .pdp__info, .pdp__buy { align-self: start; }

  .pdp__title {
    font-size: clamp(2.7rem, 1.6rem + 4.6vw, 4.4rem);
    line-height: 0.88;
    letter-spacing: 0.01em;
    margin: var(--sp-3) 0 var(--sp-5);
  }
  .pdp__price { display: flex; align-items: baseline; gap: var(--sp-3); flex-wrap: wrap; }
  .pdp__now { font-size: clamp(1.9rem, 1.3rem + 2.2vw, 2.7rem); }
  .pdp__was { color: var(--text-mute); font-size: var(--fs-400); }
  .pdp__desc { margin: var(--sp-4) 0; }
  .pdp__colorway { font-size: var(--fs-200); color: var(--text-soft); }
  .pdp__colorway .u-kicker { color: var(--text-mute); margin-right: 0.5em; }

  .pdp__accordions { margin-top: var(--sp-5); border-top: 1px solid var(--border); }
  .pdp__accordions details { border-bottom: 1px solid var(--border); }
  .pdp__accordions summary {
    display: flex; align-items: center; justify-content: space-between;
    padding: var(--sp-4) 0; cursor: pointer; list-style: none;
    font-family: var(--font-label); text-transform: uppercase;
    letter-spacing: 0.08em; font-size: var(--fs-300);
  }
  .pdp__accordions summary::-webkit-details-marker { display: none; }
  .pdp__accordions details[open] .acc-ico { transform: rotate(45deg); }
  .acc-ico { transition: transform var(--dur-2) var(--ease-out); flex: none; }
  .pdp__accordions ul { display: grid; gap: var(--sp-2); padding-bottom: var(--sp-4); }
  .pdp__accordions li {
    position: relative; padding-left: 1.1em;
    font-size: var(--fs-200); color: var(--text-soft);
  }
  .pdp__accordions li::before { content: "—"; position: absolute; left: 0; color: var(--text-mute); }

  /* ---- Galería ---- */
  .pdp__gallery { display: grid; gap: clamp(0.75rem, 2vw, 1.25rem); }
  .pdp__shot {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .pdp__shot img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 5; }

  /* ---- Compra ---- */
  .pdp__buy-inner { display: grid; gap: var(--sp-4); }
  .pdp__sizes-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--sp-3); }
  .pdp__guide {
    font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.1em;
    font-size: var(--fs-100); color: var(--text-soft); text-decoration: underline; text-underline-offset: 3px;
  }
  .pdp__size-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(56px, 1fr)); gap: var(--sp-2); }
  .pdp__size {
    padding: 0.9em 0.5em;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    font-family: var(--font-label); font-size: var(--fs-300);
    letter-spacing: 0.04em;
    transition: all var(--dur-1) var(--ease-out);
  }
  .pdp__size:hover:not(:disabled) { border-color: var(--text); }
  /* talla agotada: visible y tachada, informa disponibilidad */
  .pdp__size:disabled {
    color: var(--text-mute);
    cursor: not-allowed;
    text-decoration: line-through;
    opacity: .55;
  }
  .pdp__add:disabled { opacity: .5; cursor: not-allowed; transform: none; }
  .pdp__add.is-added { background: var(--loirn-ink); }
  .pdp__size.is-on { background: var(--loirn-ink); color: var(--loirn-paper); border-color: var(--loirn-ink); }

  .pdp__add {
    letter-spacing: 0.12em;
    transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-1) var(--ease-out), background var(--dur-2);
  }
  .pdp__add[disabled] { opacity: 0.4; cursor: not-allowed; }
  .pdp__add.is-done { background: var(--loirn-steel); }

  .pdp__mini { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-2); }
  .pdp__mini .glass-pill { justify-content: center; }
  .pdp__mini .glass-pill.is-on { background: var(--loirn-ink); color: var(--loirn-paper); }
  .pdp__ship { color: var(--text-mute); text-align: center; }

  /* ---- Barra inferior móvil ---- */
  .pdp__bar {
    position: fixed; inset: auto 0 0 0; z-index: 80;
    background: rgba(12, 12, 13, 0.9);
    backdrop-filter: blur(14px);
    border-top: 1px solid var(--d-border);
    color: var(--d-text);
    padding-block: var(--sp-3);
  }
  .pdp__bar-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4); }
  .pdp__bar-name { font-family: var(--font-label); text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--fs-200); }
  .pdp__bar-price { font-size: var(--fs-400); }
  .pdp__bar .btn { --_bg: var(--loirn-paper); --_fg: var(--loirn-ink); }
  .pdp__bar .btn[disabled] { opacity: 0.4; }

  .pgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }

  /* ================= ≥700px: la página desplaza normal, la galería es la
     que "avanza" en pantalla porque info/compra quedan pegadas (sticky) al
     mismo `top` con el que ya arrancan — sin salto ni scroll residual. ===== */
  @media (min-width: 700px) {
    .pdp__info, .pdp__buy { position: sticky; top: var(--pdp-top); }
  }
  @media (min-width: 1100px) {
    .pdp__layout {
      grid-template-columns: minmax(240px, 0.95fr) minmax(0, 1.5fr) minmax(250px, 0.9fr);
      align-items: start;
    }
    .pdp__buy-inner {
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--r-lg);
      box-shadow: var(--sh-md);
      backdrop-filter: blur(var(--glass-blur));
      padding: clamp(1.1rem, 2vw, 1.6rem);
    }
  }
  @media (min-width: 700px) and (max-width: 1099px) {
    .pdp__layout { grid-template-columns: minmax(280px, 360px) 1fr; align-items: start; }
    .pdp__info { grid-column: 1; grid-row: 1 / span 2; }
    .pdp__gallery { grid-column: 2; grid-row: 1; }
    /* en esta franja el panel de compra no flota junto a info (no caben los
       dos pegados en una columna angosta): va debajo, dentro del scroll normal. */
    .pdp__buy { position: static; grid-column: 1; grid-row: 2; margin-top: var(--sp-4); }
  }
  @media (max-width: 699px) {
    .pdp__gallery {
      grid-auto-flow: column;
      grid-auto-columns: 86%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }
    .pdp__shot { scroll-snap-align: center; }
    .pdp__info { order: 1; } .pdp__gallery { order: 0; } .pdp__buy { order: 2; }
  }
</style>

<script>
  let _buybarIO: IntersectionObserver | undefined;

  function initPDP() {
    const sizeWrap = document.querySelector<HTMLElement>("[data-sizes]");
    if (!sizeWrap || (sizeWrap as any)._wired) return;
    (sizeWrap as any)._wired = true;

    const add = document.querySelector<HTMLButtonElement>("[data-add]");
    const addLabel = document.querySelector<HTMLElement>("[data-add-label]");
    const addMirror = document.querySelector<HTMLButtonElement>("[data-add-mirror]");
    // La talla elegida define la variante: se copia su línea de carrito a los
    // dos botones de compra y el handler global de CartDrawer hace el resto.
    const buyButtons = [add, addMirror].filter(Boolean) as HTMLButtonElement[];

    function choose(b: HTMLButtonElement) {
      sizeWrap.querySelectorAll(".pdp__size").forEach((x) => {
        x.classList.remove("is-on");
        x.setAttribute("aria-checked", "false");
      });
      b.classList.add("is-on");
      b.setAttribute("aria-checked", "true");
      buyButtons.forEach((btn) => {
        btn.disabled = false;
        if (b.dataset.line) btn.dataset.line = b.dataset.line;
      });
      if (addLabel) addLabel.textContent = "Agregar al carrito";
    }

    sizeWrap.querySelectorAll<HTMLButtonElement>(".pdp__size").forEach((b) => {
      b.addEventListener("click", () => choose(b));
    });

    // Confirmación visual: el añadido en sí lo dispara el handler global.
    buyButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.disabled || !btn.dataset.line) return;
        const size = sizeWrap.querySelector<HTMLElement>(".pdp__size.is-on")?.dataset.size;
        if (addLabel) addLabel.textContent = size ? `Añadido · talla ${size}` : "Añadido";
        setTimeout(() => {
          if (addLabel) addLabel.textContent = "Agregar al carrito";
        }, 1800);
      });
    });

    document.querySelector("[data-open-guide]")?.addEventListener("click", () => {
      document.querySelectorAll<HTMLDetailsElement>(".pdp__accordions details").forEach((d, i) => {
        d.open = i === 1;
        if (i === 1) d.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    });

    document.querySelector("[data-wish]")?.addEventListener("click", (e) => {
      (e.currentTarget as HTMLElement).classList.toggle("is-on");
    });
    document.querySelector("[data-share]")?.addEventListener("click", async () => {
      const data = { title: document.title, url: location.href };
      try {
        if (navigator.share) await navigator.share(data);
        else await navigator.clipboard.writeText(location.href);
      } catch {}
    });

    // barra inferior móvil: visible cuando el panel de compra sale de vista
    const buybar = document.querySelector<HTMLElement>("[data-buybar]");
    const buy = document.querySelector<HTMLElement>(".pdp__buy");
    _buybarIO?.disconnect();
    if (buybar && buy && "IntersectionObserver" in window) {
      _buybarIO = new IntersectionObserver(
        ([e]) => { buybar.hidden = e.isIntersecting || window.innerWidth > 699; },
        { rootMargin: "-40% 0px -20% 0px" }
      );
      _buybarIO.observe(buy);
    }
  }

  document.addEventListener("astro:page-load", initPDP);
</script>
