# Shopify Storefront API — mientras estas variables no existan, el sitio corre
# con el catálogo local de src/data/products.ts y el checkout va por WhatsApp.
#
# Cómo obtenerlas:
#   Shopify admin → Settings → Apps and sales channels → Develop apps
#   → Create an app → Configure Storefront API scopes
#     (unauthenticated_read_product_listings, unauthenticated_write_checkouts,
#      unauthenticated_read_checkouts)
#   → Install app → copiar el "Storefront API access token".
#
# El token de Storefront es público por diseño (solo lee catálogo y crea
# carritos). NUNCA poner aquí un Admin API token.

PUBLIC_SHOPIFY_DOMAIN=loirn.myshopify.com
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
PUBLIC_SHOPIFY_API_VERSION=2025-07
